# Opción 1 (recomendada para pruebas): Web3Forms — https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Opción 2: tu propio Gmail (requiere contraseña de aplicación de Google)
GMAIL_USER=seba97bass@gmail.com
GMAIL_APP_PASSWORD=

