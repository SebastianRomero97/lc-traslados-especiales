# URL base del backend (cuando lo implementes)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Modo mock: usa datos locales sin llamar al backend (servicios y testimonios)
NEXT_PUBLIC_USE_MOCK_API=true

# Email — consultas del formulario
