# URL base del backend (cuando lo implementes)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Modo mock: usa datos locales sin llamar al backend (servicios y testimonios)
NEXT_PUBLIC_USE_MOCK_API=true

# Auth + base de datos (sistema interno)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="generá-un-secret-largo-aleatorio"

# Solo en desarrollo: si es true, `prisma db seed` vuelve a poner passwords de usuarios seed.
# SEED_RESET_PASSWORDS=true
# Si es true, también reescribe roles/active de usuarios seed existentes.
# SEED_RESET_ROLES=true
# En production el seed está bloqueado salvo:
# SEED_ALLOW_PRODUCTION=true

# Formulario de contacto público (deshabilitado por defecto). Activar solo si se vuelve a mostrar en la landing.
# CONTACT_ENABLED=true

# Cloudinary — imágenes de publicaciones (Dashboard → API Keys)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Mapa del recorrido (Etapa 5): por defecto OpenStreetMap + OSRM (gratis, sin clave).
# Si el dueño prefiere Google Maps Platform más adelante:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email — consultas (prescindido por ahora en el plan interno)
CONTACT_TO_EMAIL=seba97bass@gmail.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
GMAIL_USER=seba97bass@gmail.com
GMAIL_APP_PASSWORD=
