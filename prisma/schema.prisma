// Prisma schema — LC Traslados Especiales
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ADMINISTRACION
  CELADORA
  CHOFER
}

enum TipoItinerario {
  INGRESO
  SALIDA
  ADAPTACION_INGRESO
  ADAPTACION_SALIDA
  /// Especial sin sentido definido: opera como Ingreso hasta que elijan.
  ESPECIAL
  ESPECIAL_INGRESO
  ESPECIAL_SALIDA
}

enum AccionParada {
  SUBE
  BAJA
  TRASBORDO
}

enum EstadoAsistencia {
  ASISTIO
  CANCELO
}

/// Ciclo de vida de una grilla (creación → revisión Admin → operativa).
enum EstadoGrilla {
  BORRADOR
  EN_REVISION
  OBSERVADA
  APROBADA
  EN_CURSO
  FINALIZADA
}

/// Cómo se cerró la jornada (null = aún abierta / no aplica).
enum TipoCierreGrilla {
  NORMAL
  FORZADO_ADMIN
  INTERRUMPIDO
}

/// Nivel de combustible estandarizado (fracción de tanque) para comparar entre vehículos.
enum NivelCombustible {
  VACIO
  CUARTO
  MEDIO
  TRES_CUARTOS
  LLENO
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  /// Uno o más roles. Admin es exclusivo ([ADMIN]). Operativos: combinación de ADMINISTRACION / CELADORA / CHOFER.
  roles        Role[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Vehículo asignado (solo aplica si tiene rol CHOFER)
  transporteId String?
  transporte   Transporte? @relation("ChoferVehiculo", fields: [transporteId], references: [id], onDelete: SetNull)

  /// Chofer con vehículo propio (Prestador): no rinde combustible.
  isPrestador Boolean @default(false)

  areasComoCeladora       AreaCeladora[]
  areasComoChofer         AreaChofer[]
  transportesComoCeladora TransporteCeladora[]
  puntosEncuentro         PuntoEncuentro[]

  grillasComoChofer   Grilla[] @relation("GrillaChofer")
  grillasComoCeladora Grilla[] @relation("GrillaCeladora")
  grillasCreadas      Grilla[] @relation("GrillaCreador")
  grillasCierreAdmin  Grilla[] @relation("GrillaCierreAdmin")
  asistenciasRegistradas Asistencia[] @relation("AsistenciaRegistrador")
  novedadesVehiculo      NovedadVehiculo[] @relation("NovedadVehiculoAutor")
  publicacionesCreadas   Publicacion[] @relation("PublicacionAutor")
}

model Transporte {
  id        String   @id @default(cuid())
  /// Identificador visible (ej. Master). El tipo es la categoría (ej. Minibus).
  nombre    String
  tipo      String
  capacidad Int?
  /// Año del vehículo (ficha técnica).
  anio      Int?
  patente   String?
  /// Descripción libre del service pendiente.
  servicePendiente String?
  /// Fecha asociada al service pendiente (opcional).
  serviceFecha     DateTime? @db.Date
  /// Vencimiento VTV; el estado vigente/vencida se calcula desde esta fecha.
  vtvVenceAt       DateTime? @db.Date
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  choferes  User[]               @relation("ChoferVehiculo")
  areas     AreaTransporte[]
  celadoras TransporteCeladora[]
  grillas   Grilla[]
  novedades NovedadVehiculo[]
}

model Pasajero {
  id        String   @id @default(cuid())
  nombre    String
  direccion String
  /// Documento (opcional, ficha complementaria).
  dni       String?
  /// Fecha de cumpleaños (opcional).
  fechaCumpleanos DateTime? @db.Date
  /// Edad manual (opcional). Si hay cumpleaños, la UI puede calcularla.
  edad      Int?
  /// Ubicación para el mapa interno (no reemplaza el texto de dirección).
  lat       Float?
  lon       Float?
  /// Si true, Maps/Waze del chofer usan lat/lon en lugar del texto.
  usarCoordsParaChofer Boolean @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas     AreaPasajero[]
  contactos PasajeroContacto[]
  filas     GrillaFila[]
  asistencias Asistencia[]
}

/// Teléfono / contacto de un pasajero (varios por ficha).
model PasajeroContacto {
  id         String   @id @default(cuid())
  pasajeroId String
  pasajero   Pasajero @relation(fields: [pasajeroId], references: [id], onDelete: Cascade)
  /// Nombre o relación (Madre, Padre, Tutor, etc.).
  relacion   String
  telefono   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pasajeroId])
}

model Area {
  id        String   @id @default(cuid())
  nombre    String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destinos    Destino[]
  celadoras   AreaCeladora[]
  choferes    AreaChofer[]
  transportes AreaTransporte[]
  pasajeros   AreaPasajero[]
  grillas     Grilla[]
}

model Destino {
  id        String   @id @default(cuid())
  nombre    String
  domicilio String
  lat       Float?
  lon       Float?
  usarCoordsParaChofer Boolean @default(false)
  active    Boolean  @default(true)
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filas            GrillaFila[]
  pasajeroDestinos AreaPasajeroDestino[]
  areaPasajerosLegacy AreaPasajero[] @relation("AreaPasajeroDestinoLegacy")

  @@index([areaId])
}

model AreaCeladora {
  areaId String
  userId String
  area   Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([areaId, userId])
}

/// Choferes (y prestadores) disponibles en un área.
model AreaChofer {
  areaId String
  userId String
  area   Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([areaId, userId])
}

model AreaTransporte {
  areaId       String
  transporteId String
  area         Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  transporte   Transporte @relation(fields: [transporteId], references: [id], onDelete: Cascade)

  @@id([areaId, transporteId])
}

model AreaPasajero {
  areaId     String
  pasajeroId String
  /// Legacy (ya migrado a AreaPasajeroDestino). No usar en código nuevo.
  destinoId  String?
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  pasajero   Pasajero @relation(fields: [pasajeroId], references: [id], onDelete: Cascade)
  destino    Destino? @relation("AreaPasajeroDestinoLegacy", fields: [destinoId], references: [id], onDelete: SetNull)
  destinos   AreaPasajeroDestino[]

  @@id([areaId, pasajeroId])
  @@index([destinoId])
}

/// Un pasajero puede tener varios destinos habituales en el área.
model AreaPasajeroDestino {
  areaId     String
  pasajeroId String
  destinoId  String
  areaPasajero AreaPasajero @relation(fields: [areaId, pasajeroId], references: [areaId, pasajeroId], onDelete: Cascade)
  destino      Destino      @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@id([areaId, pasajeroId, destinoId])
  @@index([destinoId])
}

/// Punto de encuentro de una celadora (puede guardarse como frecuente).
model PuntoEncuentro {
  id         String   @id @default(cuid())
  nombre     String?
  direccion  String
  lat        Float?
  lon        Float?
  usarCoordsParaChofer Boolean @default(false)
  celadoraId String
  celadora   User     @relation(fields: [celadoraId], references: [id], onDelete: Cascade)
  /// Si true, queda disponible para reutilizar en otras grillas.
  frecuente  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  grillas Grilla[]

  @@index([celadoraId])
}

model TransporteCeladora {
  transporteId String
  userId       String
  transporte   Transporte @relation(fields: [transporteId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([transporteId, userId])
}

/// Hoja de ruta / itinerario diario
model Grilla {
  id             String         @id @default(cuid())
  /// Nombre editable de la grilla (crear / editar / borrar).
  nombre         String         @default("Sin nombre")
  tipoItinerario TipoItinerario
  fecha          DateTime       @db.Date
  nota           String?
  /// Estado del flujo de aprobación / operativa.
  estado         EstadoGrilla   @default(BORRADOR)
  /// Nota del Admin cuando observa / pide corrección.
  notaRevision   String?
  conCeladora    Boolean        @default(true)

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  transporteId String
  transporte   Transporte @relation(fields: [transporteId], references: [id], onDelete: Restrict)

  choferId String
  chofer   User   @relation("GrillaChofer", fields: [choferId], references: [id], onDelete: Restrict)

  celadoraId String?
  celadora   User?   @relation("GrillaCeladora", fields: [celadoraId], references: [id], onDelete: SetNull)

  /// Punto de encuentro de la celadora (si no parte desde la base con el chofer).
  puntoEncuentroId String?
  puntoEncuentro   PuntoEncuentro? @relation(fields: [puntoEncuentroId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("GrillaCreador", fields: [createdById], references: [id], onDelete: Restrict)

  /// Reloj chofer: manejo del vehículo
  choferInicioAt DateTime?
  choferFinAt    DateTime?
  /// Reloj celadora: subida / operación con pasajeros
  celadoraInicioAt DateTime?
  celadoraFinAt    DateTime?

  informeChofer   String?
  informeCeladora String?

  /// Informe estructurado del chofer (cierre de jornada)
  informeChoferCeladora  String?
  informeChoferVehiculo  String?
  combustibleNivel       NivelCombustible?

  /// Cierre de jornada (normal del chofer o Admin forzado/interrumpido).
  cierreTipo    TipoCierreGrilla?
  cierreNota    String?
  cerradoPorId  String?
  cerradoPor    User?     @relation("GrillaCierreAdmin", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  cerradoAt     DateTime?

  filas        GrillaFila[]
  asistencias  Asistencia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([choferId])
  @@index([celadoraId])
  @@index([areaId])
  @@index([estado])
}

model GrillaFila {
  id             String      @id @default(cuid())
  grillaId       String
  grilla         Grilla      @relation(fields: [grillaId], references: [id], onDelete: Cascade)
  orden          Int
  /// Opcional en pasajeros (Maps puede sugerirlo); fijo en destinos.
  hora           String?
  direccion      String
  /// Snapshot de ubicación para mapa / Maps-Waze de esta grilla.
  lat            Float?
  lon            Float?
  usarCoordsParaChofer Boolean @default(false)
  pasajeroNombre String
  pasajeroId     String?
  pasajero       Pasajero?   @relation(fields: [pasajeroId], references: [id], onDelete: SetNull)
  destinoId      String?
  destino        Destino?    @relation(fields: [destinoId], references: [id], onDelete: SetNull)
  accion         AccionParada
  /// Nombre del otro vehículo cuando accion = TRASBORDO
  trasbordoHacia String?

  @@index([grillaId])
}

/// Asistencia de un pasajero en una grilla (una por pasajero/nombre en el recorrido)
model Asistencia {
  id                String           @id @default(cuid())
  grillaId          String
  grilla            Grilla           @relation(fields: [grillaId], references: [id], onDelete: Cascade)
  pasajeroId        String?
  pasajero          Pasajero?        @relation(fields: [pasajeroId], references: [id], onDelete: SetNull)
  pasajeroNombre    String
  estado            EstadoAsistencia
  motivoCancelacion String?
  registradoPorId   String
  registradoPor     User             @relation("AsistenciaRegistrador", fields: [registradoPorId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([grillaId, pasajeroNombre])
  @@index([grillaId])
  @@index([pasajeroId])
}

enum EstadoNovedadVehiculo {
  PENDIENTE_REVISION
  RESUELTO
}

/// Novedad / aviso del chofer sobre su vehículo (historial en la ficha del vehículo)
model NovedadVehiculo {
  id           String   @id @default(cuid())
  mensaje      String
  estado       EstadoNovedadVehiculo @default(PENDIENTE_REVISION)
  /// Comentario / detalle del Admin sobre la novedad.
  detalleAdmin String?
  transporteId String
  transporte   Transporte @relation(fields: [transporteId], references: [id], onDelete: Cascade)
  reportadoPorId String
  reportadoPor   User   @relation("NovedadVehiculoAutor", fields: [reportadoPorId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([transporteId])
  @@index([createdAt])
  @@index([estado])
}

/// Aviso del Admin hacia roles operativos (con vigencia)
model Publicacion {
  id          String   @id @default(cuid())
  titulo      String
  cuerpo      String
  /// Imagen opcional (Cloudinary).
  imagenUrl      String?
  imagenPublicId String?
  /// Roles destinatarios: ADMINISTRACION, CELADORA y/o CHOFER (selección manual del Admin)
  roles       Role[]
  startsAt    DateTime @default(now())
  endsAt      DateTime
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("PublicacionAutor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([endsAt])
  @@index([active])
}
